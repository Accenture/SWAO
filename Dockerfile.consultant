# SWAO Consultant Edition -- Docker (sprint-140, ADR-0056)
#
# Binary-wrap approach: packages the pre-built swao-consultant-linux-* binary
# (produced by the build-consultant CI job) into a minimal Debian container.
# No pnpm workspace install required -- the pkg binary is self-contained
# (Node.js runtime + compiled sources + native modules all bundled).
#
# Sprint-140 pivot: after 22+ CI attempts, pnpm workspace install reliably
# no-ops inside Docker across all environments (Alpine, Debian, pnpm@9/10/11,
# frozen/non-frozen, with/without lockfile). The binary produced by the native
# build-consultant job is already tested and published; wrapping it eliminates
# the pnpm-in-Docker issue class entirely.
#
# Built by: private CI (release-consultant.yml publish-docker-consultant)
# Push target: ghcr.io/accenture-cloud-first-tech/swao-consultant:*
#
# Usage:
#   docker pull ghcr.io/accenture-cloud-first-tech/swao-consultant:latest
#   docker run --rm -v $(pwd):/workspace -v /path/to/licence.json:/licence.json \
#              ghcr.io/accenture-cloud-first-tech/swao-consultant:latest --version
#
# Licence file: mount via `-v licence.json:/licence.json`. See ADR-0056 OQ-097-04.

FROM debian:bookworm-slim
WORKDIR /workspace
ENV SWAO_BINARY_TIER=consultant

# Runtime prerequisites:
#   git            -- `swao assess` shells out to `git clone` for source ingestion
#   openssh-client -- the SSH-key clone path alongside HTTPS+PAT
#   ca-certificates -- Debian slim ships it; explicit for clarity
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# BINARY_NAME is injected by the CI matrix (swao-consultant-linux-x64 for amd64,
# swao-consultant-linux-arm64 for arm64). It is a file inside the ./docker-build/
# build context, produced by the build-consultant job and downloaded as an artifact.
ARG BINARY_NAME=swao-consultant-linux-x64
COPY ${BINARY_NAME} /usr/local/bin/swao
RUN chmod +x /usr/local/bin/swao

# OCI labels -- consumed by ghcr.io UI, image inspectors.
LABEL org.opencontainers.image.title="SWAO Consultant" \
      org.opencontainers.image.description="SWAO -- Sovereign Workload Assessment and Onboarding (Consultant Edition, proprietary)" \
      org.opencontainers.image.vendor="Accenture" \
      org.opencontainers.image.licenses="Proprietary" \
      org.opencontainers.image.source="https://github.com/Accenture/SWAO"

# /workspace is the operator's bind-mounted portfolio; SWAO reads + writes it.
ENTRYPOINT ["/usr/local/bin/swao"]
