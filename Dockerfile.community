# SWAO Community Edition -- Docker (sprint-147, #3031)
#
# Binary-wrap approach: packages the pre-built swao-community-linux-* binary
# (produced by the build CI job) into a minimal Debian container.
# No pnpm workspace install required -- the pkg binary is self-contained
# (Node.js runtime + compiled sources + native modules all bundled).
#
# Sprint-147 pivot: mirrors the sprint-140 binary-wrap fix applied to
# Dockerfile.enterprise. The prior multi-stage pnpm build reliably no-ops
# inside Docker (pnpm workspace with out-of-root package globs installs
# 0 packages). The pre-built community binary is already tested and published;
# wrapping it eliminates the pnpm-in-Docker issue class entirely.
#
# Built by: public CI (release-community.yml publish-docker-community)
# Push target: ghcr.io/accenture/swao-community:*
#
# Usage:
#   docker pull ghcr.io/accenture/swao-community:latest
#   docker run --rm -v $(pwd):/workspace ghcr.io/accenture/swao-community:latest --version

FROM debian:bookworm-slim
WORKDIR /workspace
ENV SWAO_BINARY_TIER=community

# Runtime prerequisites:
#   git            -- `swao assess` shells out to `git clone` for source ingestion
#   openssh-client -- the SSH-key clone path alongside HTTPS+PAT
#   ca-certificates -- Debian slim ships it; explicit for clarity
RUN apt-get update && apt-get install -y --no-install-recommends \
      git openssh-client ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# BINARY_NAME is injected by the CI matrix (swao-community-linux-x64 for amd64,
# swao-community-linux-arm64 for arm64). It is a file inside the ./docker-build/
# build context, produced by the build job and downloaded as an artifact.
ARG BINARY_NAME=swao-community-linux-x64
COPY ${BINARY_NAME} /usr/local/bin/swao
RUN chmod +x /usr/local/bin/swao

# OCI labels -- consumed by ghcr.io UI, image inspectors.
LABEL org.opencontainers.image.title="SWAO Community" \
      org.opencontainers.image.description="SWAO -- Sovereign Workload Assessment and Onboarding (Community Edition, Apache-2.0)" \
      org.opencontainers.image.vendor="Accenture" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.source="https://github.com/Accenture/SWAO"

# /workspace is the operator's bind-mounted portfolio; SWAO reads + writes it.
ENTRYPOINT ["/usr/local/bin/swao"]
