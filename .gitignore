# ── Source packages (not published until OSS legal approval -- issue #2139) ──
# Robocopy /XD prevents copying but does not delete from destination; .gitignore
# ensures the directory is never tracked in the public repo even if it re-appears.
packages/

# ── Build output ─────────────────────────────────────────────────────────────
dist/
dist-bin/*
!dist-bin/SHA256SUMS
!dist-bin/README.txt
!dist-bin/swao.bat
*.js.map

# ── Secrets (never commit) ────────────────────────────────────────────────────
.signing-secret
**/.signing-secret
.env
.env.*
!.env.example
secrets/.env
secrets/.env.local

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/

# ── Runtime assessment outputs (not for source control) ─────────────────────
docs/publication/
build-log.txt

# ── Demo subject source clones ──────────────────────────────────────────────
# Each demo workspace has a `source/` subfolder containing a clone of the
# upstream application being assessed (Medplum, Ghostfolio, etc.). These are
# large (100s of MB), have their own .git/, and are re-clonable. SWAO needs
# them on disk for assessment runs, but they don't belong in this repo.
examples/portfolio-workspace/portfolio/apps/*/source/

# ── TypeScript incremental build cache ───────────────────────────────────────
*.tsbuildinfo

# ── Test artefacts ────────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/

# ── LLM response cache (#0472) -- workspace-local; contains client data ──────
# Never commit -- re-cached on first run after cache miss or expiry.
wsp/cache/

# ── Accepted-run lock (#0477) -- workspace-local operator state ───────────────
# Never commit -- this is per-operator, not shared source-controlled state.
wsp/accepted-run.json

# ── SEA (Single Executable Application) build intermediates ─────────────────
# Generated by `npm run build:sea` via scripts/sea-build.mjs; not committed.
sea-config.json
sea-prep.blob
# Re-ignore SEA binaries after the !dist-bin/swao-* negation above.
dist-bin/swao-sea-*

# ── Claude Code session artefacts ────────────────────────────────────────────
# .claude/ contains slash commands and agents checked into the repo, but the
# session-local state (worktrees/, mcp configs) must not be committed.
.claude/worktrees/
.claude/settings.local.json

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
*.swp
*.orig
