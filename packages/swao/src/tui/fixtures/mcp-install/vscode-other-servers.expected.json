{
  "servers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "swao": {
      "type": "stdio",
      "command": "<BIN>",
      "args": [
        "mcp",
        "--workspace",
        "<WS>",
        "--profile",
        "full"
      ]
    }
  },
  "inputs": []
}
