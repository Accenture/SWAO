{
  "$schema": "https://example.invalid/kilo-config.json",
  "model": "ollama/qwen3:8b",
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://example.invalid/mcp",
      "enabled": false
    },
    "swao": {
      "type": "local",
      "command": [
        "<BIN>",
        "mcp",
        "--workspace",
        "<WS>",
        "--profile",
        "starter"
      ],
      "enabled": true
    }
  },
  "theme": "dark"
}
