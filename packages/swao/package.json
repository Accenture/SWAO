{
  "name": "@swao/swao",
  "version": "0.11.2",
  "description": "SWAO CLI -- Sovereign Workload Assessment and Onboarding",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "bin": {
    "swao": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "build:bundle": "node scripts/bundle.mjs",
    "bump:patch": "node scripts/bump-version.mjs",
    "bump:minor": "node scripts/bump-version.mjs minor",
    "bump:major": "node scripts/bump-version.mjs major",
    "release": "npm run bump:patch && npm run build:binary",
    "build:binary": "npm run build && node scripts/build-enterprise.mjs",
    "build:binary:community": "npm run build && node scripts/build-community.mjs",
    "build:binary:consultant": "npm run build && node scripts/build-consultant.mjs",
    "build:binary:enterprise": "npm run build && node scripts/build-enterprise.mjs",
    "build:binary:all-win": "npm run build:binary:community && npm run build:binary:consultant && npm run build:binary:enterprise",
    "build:dev:win": "npm run build && node scripts/build-dev-win.mjs",
    "build:sea": "npm run build && npm run build:bundle && node scripts/sea-build.mjs",
    "build:binary:linux-x64": "npm run build && npm run build:bundle && npx @yao-pkg/pkg dist/bundle.cjs --config package.json --target node20-linux-x64 --output ../../dist-bin/swao-linux-x64 --compress GZip --fallback-to-source",
    "build:binary:win-x64": "npm run build && npm run build:bundle && npx @yao-pkg/pkg dist/bundle.cjs --config package.json --target node20-win-x64 --output ../../dist-bin/swao-enterprise-win.exe --compress GZip --fallback-to-source",
    "build:binary:darwin-x64": "npm run build && npm run build:bundle && npx @yao-pkg/pkg dist/bundle.cjs --config package.json --target node20-macos-x64 --output ../../dist-bin/swao-darwin-x64 --compress GZip --fallback-to-source",
    "build:binary:darwin-arm64": "npm run build && npm run build:bundle && npx @yao-pkg/pkg dist/bundle.cjs --config package.json --target node20-macos-arm64 --output ../../dist-bin/swao-darwin-arm64 --compress GZip --fallback-to-source",
    "dev": "tsc --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "vitest run --pool forks",
    "test:coverage": "vitest run --pool forks --coverage",
    "test:e2e": "node_modules/.bin/playwright test",
    "test:crawl": "vitest run --config vitest.crawl.config.ts",
    "test:smoke": "vitest run --pool forks src/__tests__/cli-smoke.test.ts src/__tests__/pass-smoke.test.ts",
    "typecheck": "tsc -b tsconfig.json",
    "record:tui": "node -e \"require('child_process').spawn(process.platform==='win32'?'powershell':'bash',[process.platform==='win32'?'../../../scripts/record-tui.ps1':'../../../scripts/record-tui.sh'],{stdio:'inherit'})\""
  },
  "pkg": {
    "assets": [
      "package.json",
      "dist/passes/fixtures/**",
      "../../controls/**",
      "dist/_community-frameworks/**",
      "dist/templates/powerbi/**",
      "../../../examples/portfolio-workspace/portfolio/apps/ghostfolio/wsp/inputs/terraform/lz-*-snapshot.json",
      "dist/data/*",
      "dist/publish/assets/**",
      "dist/publish/i18n/**",
      "dist/_lz-catalogues/**",
      "dist/_llm-gateway/**",
      "dist/_premium-frameworks/**",
      "dist/_demo-frameworks/**",
      "../../docs/getting-started.md",
      "../../docs/assessment-dimension-catalogue.md",
      "!node_modules/.pnpm/@playwright*/**",
      "!node_modules/.pnpm/playwright*/**",
      "!dist/**/*chromium*",
      "!dist/**/*playwright-driver*"
    ],
    "targets": [
      "node20-win-x64",
      "node20-linux-x64",
      "node20-macos-x64"
    ],
    "outputPath": "../../dist-bin"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@swao/community-frameworks": "workspace:*",
    "@swao/core": "workspace:*",
    "@swao/module-app-assessment": "workspace:*",
    "@swao/module-challenge": "workspace:*",
    "@swao/module-framework": "workspace:*",
    "@swao/module-health-check": "workspace:*",
    "@swao/module-html-portal": "workspace:*",
    "@swao/module-html-report": "workspace:*",
    "@swao/module-landing-zone": "workspace:*",
    "@swao/module-llm-assessment": "workspace:*",
    "@swao/module-llm-providers": "workspace:*",
    "@swao/module-mcp": "workspace:*",
    "@swao/module-pdf-report": "workspace:*",
    "@swao/module-portfolio": "workspace:*",
    "@swao/module-powerbi": "workspace:*",
    "@swao/module-terraform": "workspace:*",
    "@swao/tui-kit": "workspace:*",
    "@types/pdfkit": "^0.17.6",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "js-yaml": "^4.2.0",
    "mammoth": "^1.12.0",
    "node-pty": "^1.1.0",
    "pdfkit": "^0.18.0",
    "react": "^18.3.1",
    "yoga-layout-prebuilt": "^1.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.28",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.1.9",
    "ajv": "^8.20.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "ink-testing-library": "^4.0.0",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "form-data": "^4.0.6",
    "hono": "^4.13.1",
    "ws": "^8.21.0",
    "ip-address": "^10.1.1",
    "uuid": "^11.0.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=4.1.2",
      "form-data": ">=4.0.6",
      "hono": ">=4.13.1",
      "ws": ">=8.21.0",
      "vite": ">=7.3.5 <9.0.0",
      "ip-address": ">=10.3.1",
      "uuid": ">=11.0.0",
      "tmp": ">=0.2.6",
      "js-yaml": ">=5.2.2",
      "adm-zip": ">=0.6.0",
      "brace-expansion": ">=5.0.9",
      "body-parser": ">=2.3.0",
      "find-my-way": ">=9.7.0",
      "postcss": ">=8.5.18",
      "nanoid": ">=3.3.17",
      "liquidjs": ">=10.27.1",
      "@fastify/static": ">=10.1.2",
      "@hono/node-server": ">=2.0.5"
    }
  }
}
