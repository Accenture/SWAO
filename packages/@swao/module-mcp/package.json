{
  "name": "@swao/module-mcp",
  "version": "0.1.0",
  "description": "SWAO MCP module: the Model Context Protocol server (stdio + HTTP transports) and the `mcp` CLI command. Spawns the host SWAO CLI for tool calls; the host injects the CLI invocation via McpHostDeps.",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --pool forks"
  },
  "dependencies": {
    "@swao/core": "workspace:*",
    "@swao/community-frameworks": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "js-yaml": "^4.2.0"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
