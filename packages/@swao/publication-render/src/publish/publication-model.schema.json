{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swao.accenture.com/schemas/publication-model/1.0",
  "title": "PublicationModel",
  "description": "SWAO publication contract v1.0 -- Design 041 §4.2 + §15.4",
  "type": "object",
  "required": [
    "contract_version",
    "meta",
    "summary",
    "signals",
    "compliance",
    "risk_register",
    "runbook",
    "evidence",
    "input_files",
    "tags",
    "lzr",
    "run_history"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "string",
      "enum": ["1.0", "1.1"]
    },
    "meta": { "$ref": "#/definitions/PublicationMeta" },
    "summary": { "$ref": "#/definitions/PublicationSummary" },
    "signals": {
      "type": "array",
      "items": { "$ref": "#/definitions/PubSignal" }
    },
    "compliance": {
      "type": "array",
      "items": { "$ref": "#/definitions/FrameworkResult" }
    },
    "risk_register": {
      "type": "array",
      "items": { "$ref": "#/definitions/RiskRegisterItem" }
    },
    "runbook": {
      "type": "array",
      "items": { "$ref": "#/definitions/RunbookStep" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/PubEvidence" }
    },
    "input_files": {
      "type": "array",
      "items": { "$ref": "#/definitions/InputFile" }
    },
    "tags": { "$ref": "#/definitions/TagIndex" },
    "lzr": { "$ref": "#/definitions/LZRSummary" },
    "run_history": {
      "type": "array",
      "items": { "$ref": "#/definitions/RunSummary" }
    },
    "delta": { "$ref": "#/definitions/DeltaModel" },
    "assessment_type": { "type": "string" },
    "block_profile": { "type": "string" },
    "block_overrides": { "type": "object" }
  },
  "definitions": {
    "Severity": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "informational", "positive"]
    },
    "RagStatus": {
      "type": "string",
      "enum": ["pass", "partial", "fail", "not-assessed"]
    },
    "Tier": {
      "type": "string",
      "enum": ["community", "consultant", "enterprise"]
    },
    "EvidenceType": {
      "type": "string",
      "enum": ["imported_artifact", "derived", "meeting_transcript"]
    },
    "InputFileKind": {
      "type": "string",
      "enum": ["architecture", "adr", "banf", "eam", "source"]
    },
    "RiskStatus": {
      "type": "string",
      "enum": ["open", "in_progress", "resolved"]
    },
    "EngagementMeta": {
      "type": "object",
      "required": ["engagement_name", "partnership_lead"],
      "additionalProperties": false,
      "properties": {
        "engagement_name": { "type": "string" },
        "client_code": { "type": "string" },
        "partnership_lead": { "type": "string" },
        "engagement_lead": { "type": "string" },
        "account_executive": { "type": "string" },
        "primary_contact": { "type": "string" },
        "secondary_contact": { "type": "string" }
      }
    },
    "PubSignal": {
      "type": "object",
      "required": ["id", "pass", "severity", "outcome", "derivation", "evidence_refs", "implies", "tags", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "pass": { "type": "string" },
        "severity": { "$ref": "#/definitions/Severity" },
        "outcome": { "type": "string", "enum": ["positive", "negative", "informational"] },
        "derivation": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "implies": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "anchor": { "type": "string" }
      }
    },
    "PubEvidence": {
      "type": "object",
      "required": ["id", "title", "type", "file", "date", "pii_scrubbed", "used_by"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "$ref": "#/definitions/EvidenceType" },
        "file": { "type": "string" },
        "date": { "type": "string" },
        "link": { "type": "string" },
        "pii_scrubbed": { "type": "boolean" },
        "used_by": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "source_path": { "type": "string" },
        "refs": { "type": "array", "items": { "type": "string" } },
        "github_url": { "type": "string" }
      }
    },
    "InputFile": {
      "type": "object",
      "required": ["path", "kind"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "kind": { "$ref": "#/definitions/InputFileKind" },
        "link": { "type": "string" }
      }
    },
    "TagIndexEntry": {
      "type": "object",
      "required": ["anchor", "type", "label"],
      "additionalProperties": false,
      "properties": {
        "anchor": { "type": "string" },
        "type": { "type": "string" },
        "label": { "type": "string" }
      }
    },
    "TagIndex": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/definitions/TagIndexEntry" }
      }
    },
    "ControlResult": {
      "type": "object",
      "required": ["id", "title", "rag_status", "signals", "rationale", "evidence", "anchor"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "rag_status": { "$ref": "#/definitions/RagStatus" },
        "worst_severity": { "$ref": "#/definitions/Severity" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "article_text": { "type": "string" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "anchor": { "type": "string" },
        "derived_from": { "type": "string" }
      }
    },
    "FrameworkResult": {
      "type": "object",
      "required": ["framework_id", "framework_name", "controls", "fail_count", "partial_count", "pass_count"],
      "additionalProperties": false,
      "properties": {
        "not_assessed_count": { "type": "integer", "minimum": 0, "default": 0 },
        "framework_id": { "type": "string" },
        "framework_name": { "type": "string" },
        "controls": { "type": "array", "items": { "$ref": "#/definitions/ControlResult" } },
        "fail_count": { "type": "integer", "minimum": 0 },
        "partial_count": { "type": "integer", "minimum": 0 },
        "pass_count": { "type": "integer", "minimum": 0 }
      }
    },
    "RiskRegisterItem": {
      "type": "object",
      "required": ["risk_id", "trigger", "category", "likelihood", "impact", "mitigation", "owner", "evidence_refs", "status", "anchor"],
      "additionalProperties": false,
      "properties": {
        "risk_id": { "type": "string" },
        "signal_ref": { "type": "string" },
        "trigger": { "type": "string" },
        "category": { "type": "string" },
        "likelihood": { "type": "string", "enum": ["low", "medium", "high"] },
        "impact": { "type": "string", "enum": ["low", "medium", "high"] },
        "mitigation": { "type": "string" },
        "owner": { "type": "string" },
        "migration_phase": { "type": "string" },
        "effort": { "type": "string", "enum": ["S", "M", "L", "XL"] },
        "target_date": { "type": "string" },
        "platform_impact": { "type": "string" },
        "evidence_refs": { "type": "array", "items": { "type": "string" } },
        "status": { "$ref": "#/definitions/RiskStatus" },
        "resolved_at": { "type": "string" },
        "notes": { "type": "string" },
        "severity": { "$ref": "#/definitions/Severity" },
        "anchor": { "type": "string" }
      }
    },
    "RunbookStep": {
      "type": "object",
      "required": ["step", "title", "description", "signals", "anchor"],
      "additionalProperties": false,
      "properties": {
        "step": { "type": "integer", "minimum": 1 },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "pass": { "type": "string" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "anchor": { "type": "string" }
      }
    },
    "LZRCheck": {
      "type": "object",
      "required": ["id", "label", "result"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "result": { "type": "string", "enum": ["pass", "fail", "not_applicable"] },
        "signal_ref": { "type": "string" }
      }
    },
    "LZRSummary": {
      "type": "object",
      "required": ["overall", "blockers", "checks"],
      "additionalProperties": false,
      "properties": {
        "overall": { "type": "string" },
        "blockers": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "$ref": "#/definitions/LZRCheck" } },
        "current_infra": { "type": "string" },
        "lz_status": { "type": "string" },
        "lz_catalogue": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "region": { "type": "string" },
            "overall_verdict": { "type": "string" }
          }
        },
        "catalog": {
          "type": "object",
          "properties": {
            "provider": { "type": "string" },
            "region": { "type": "string" },
            "overall_verdict": { "type": "string" },
            "assessed_regions": { "type": "array", "items": { "type": "string" } },
            "service_count": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "RunSummary": {
      "type": "object",
      "required": ["run_id", "assessed_at", "swao_version", "signal_counts"],
      "additionalProperties": false,
      "properties": {
        "run_id": { "type": "string" },
        "assessed_at": { "type": "string" },
        "swao_version": { "type": "string" },
        "signal_counts": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "publication_href": { "type": "string" }
      }
    },
    "DeltaModel": {
      "type": "object",
      "required": ["run_a", "run_b", "new_signals", "resolved_signals", "changed_signals"],
      "additionalProperties": false,
      "properties": {
        "run_a": { "type": "string" },
        "run_b": { "type": "string" },
        "new_signals": { "type": "array", "items": { "type": "string" } },
        "resolved_signals": { "type": "array", "items": { "type": "string" } },
        "changed_signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PublicationConfig": {
      "type": "object",
      "required": ["classification_band", "logo_name", "logo_sub", "footer_note", "engagement_lead_label", "primary_contact_label", "secondary_contact_label"],
      "additionalProperties": false,
      "properties": {
        "classification_band": { "type": "string" },
        "logo_name": { "type": "string" },
        "logo_sub": { "type": "string" },
        "footer_note": { "type": "string" },
        "engagement_lead_label": { "type": "string" },
        "primary_contact_label": { "type": "string" },
        "secondary_contact_label": { "type": "string" }
      }
    },
    "PublicationMeta": {
      "type": "object",
      "required": ["app_id", "app_name", "assessed_at", "run_id", "swao_version", "engagement", "licensee", "tier", "publication_config"],
      "additionalProperties": false,
      "properties": {
        "app_id": { "type": "string" },
        "app_name": { "type": "string" },
        "assessed_at": { "type": "string" },
        "run_id": { "type": "string" },
        "swao_version": { "type": "string" },
        "engagement": { "$ref": "#/definitions/EngagementMeta" },
        "licensee": { "type": "string" },
        "tier": { "$ref": "#/definitions/Tier" },
        "publication_config": { "$ref": "#/definitions/PublicationConfig" }
      }
    },
    "PublicationSummary": {
      "type": "object",
      "required": ["seven_r_label", "coverage_score", "signal_counts", "blocker_count", "top_findings"],
      "additionalProperties": false,
      "properties": {
        "seven_r_label": { "type": "string" },
        "coverage_score": { "type": "number", "minimum": 0, "maximum": 1 },
        "signal_counts": {
          "type": "object",
          "additionalProperties": { "type": "number" }
        },
        "blocker_count": { "type": "integer", "minimum": 0 },
        "top_findings": {
          "type": "array",
          "items": { "$ref": "#/definitions/PubSignal" }
        },
        "prior_run_id": { "type": "string" }
      }
    }
  }
}
