      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --pool forks"
  },
  "dependencies": {
    "@swao/core": "workspace:*",
    "@swao/community-frameworks": "workspace:*",
    "@swao/module-landing-zone": "workspace:*",
    "@swao/tui-kit": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^4.4.1",
    "js-yaml": "^4.2.0",
    "react": "^18.3.1"
  },
  "peerDependencies": {
    "typescript": ">=5.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.28",
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
